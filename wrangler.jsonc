{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chengdu-reader",
  "main": "api/worker.ts",
  "compatibility_date": "2025-09-01",
  // nodejs_compat：让 process.env / node:path 这类用法在 Workers 上可用，
  // 这样 api/ 下的代码不用为两个运行时写两套。
  "compatibility_flags": ["nodejs_compat"],
  // sitemap.xml 打进 Worker 时按文本处理。txt 已在 Wrangler 默认 Text 规则里。
  "rules": [{ "type": "Text", "globs": ["**/*.xml"], "fallthrough": true }],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    // 前端是单页应用：未命中静态文件时回退 index.html，深链接才不会 404
    "not_found_handling": "single-page-application",
    // 这些路径必须先交给 Worker：否则 SPA 回退会直接返回 index.html。
    // /admin 会变成首页，/api 到不了 Hono，/robots.txt 与 /sitemap.xml 会变成壳页。
    "run_worker_first": ["/admin", "/api/*", "/robots.txt", "/sitemap.xml"],
  },
  "observability": {
    "enabled": true,
  },
  // 院校上报的存储：KV 命名空间，键形如 p:<时间>:<uuid>
  "kv_namespaces": [
    { "binding": "PROFILES", "id": "8dcc463a9c3c411d92a283da4800ab02" },
  ],
  // 自定义域：zone 激活后由 Cloudflare 自动创建 DNS 记录并签发证书，
  // 不需要手动加 A/CNAME。部署前 zone 必须是 Active，否则 wrangler 会报错。
  "routes": [
    { "pattern": "cdreader.top", "custom_domain": true },
    { "pattern": "www.cdreader.top", "custom_domain": true },
  ],
  // 默认不配任何变量：访客自带 Key 模式。站长自用演示时再取消注释：
  // "vars": { "OWNER_KEY_POLICY": "open" }
  "vars": {},
}
