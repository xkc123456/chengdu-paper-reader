{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xing2557",
  "main": "api/worker.ts",
  "compatibility_date": "2025-09-01",
  // nodejs_compat：让 process.env / node:path 这类用法在 Workers 上可用，
  // 这样 api/ 下的代码不用为两个运行时写两套。
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    // 前端是单页应用：未命中静态文件时回退 index.html，深链接才不会 404
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // 默认不配任何变量：访客自带 Key 模式。站长自用演示时再取消注释：
  // "vars": { "OWNER_KEY_POLICY": "open" }
  "vars": {}
}
