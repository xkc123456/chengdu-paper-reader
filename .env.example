# ── 站长自用（可选）─────────────────────────────────────────────
# 你自己的 DeepSeek Key。仅在 OWNER_KEY_POLICY=open 时才会被访客请求借用。
# 默认 closed：访客必须填自己的 Key，你的额度不会被外人消耗。
DEEPSEEK_API_KEY=
OWNER_KEY_POLICY=closed

# ── 模型接入（一般不用改）───────────────────────────────────────
# 任何 OpenAI 兼容端点都可以：把 baseURL 换成对应服务商即可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── 运行参数 ───────────────────────────────────────────────────
PORT=3000
# 每个 IP 每小时最多发起多少次解析（0 = 不限）
RATE_LIMIT_PER_HOUR=30
# 日志目录，默认 ./.data/logs
LOG_DIR=
