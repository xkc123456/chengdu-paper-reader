{
  "name": "chengdu-paper-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/server.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.78",
    "@hono/node-server": "^1.14.3",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "ai": "6.0.290",
    "dotenv": "^17.2.3",
    "hono": "^4.8.3",
    "lucide-react": "^1.64.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.6",
    "tesseract.js": "^5.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.19.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.27.2",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vitest": "^4.0.16",
    "wrangler": "^4.156.0"
  }
}
